# SSH Configuration Template for Clisonix Cloud Hetzner Servers
# Location: ~/.ssh/config (Linux/Mac) or %USERPROFILE%\.ssh\config (Windows)
# Usage: ssh hetzner-prod, ssh hetzner-new, etc.

# ═══════════════════════════════════════════════════════════════════════════
# PRODUCTION SERVER (46.225.14.83)
# ═══════════════════════════════════════════════════════════════════════════

Host hetzner-prod
    HostName 46.225.14.83
    User root
    Port 22
    IdentityFile ~/.ssh/hetzner_deploy_key
    IdentityFile ~/.ssh/id_rsa
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    AddKeysToAgent yes
    ConnectTimeout 10
    ServerAliveInterval 60
    ServerAliveCountMax 3
    Compression yes
    # PreferredAuthentications publickey,password

# ═══════════════════════════════════════════════════════════════════════════
# NEW SERVER TEMPLATE (hetzner-new)
# SETUP: Update HETZNER_NEW_IP with actual server IP
# ═══════════════════════════════════════════════════════════════════════════

Host hetzner-new
    HostName HETZNER_NEW_IP
    User root
    Port 22
    IdentityFile ~/.ssh/hetzner_deploy_key
    IdentityFile ~/.ssh/id_rsa
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    AddKeysToAgent yes
    ConnectTimeout 10
    ServerAliveInterval 60
    ServerAliveCountMax 3
    Compression yes

# ═══════════════════════════════════════════════════════════════════════════
