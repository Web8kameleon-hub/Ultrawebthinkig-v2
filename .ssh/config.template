# ═══════════════════════════════════════════════════════════════════════════
# CLISONIX USER (non-root access)
# SETUP: Use after creating 'clisonix' user on server
# ═══════════════════════════════════════════════════════════════════════════

Host hetzner-prod-user
    HostName 46.225.14.83
    User clisonix
    Port 22
    IdentityFile ~/.ssh/hetzner_deploy_key
    IdentityFile ~/.ssh/id_rsa
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    AddKeysToAgent yes
    ConnectTimeout 10

Host hetzner-new-user
    HostName HETZNER_NEW_IP
    User clisonix
    Port 22
    IdentityFile ~/.ssh/hetzner_deploy_key
    IdentityFile ~/.ssh/id_rsa
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    AddKeysToAgent yes
    ConnectTimeout 10

# ═══════════════════════════════════════════════════════════════════════════
# GLOBAL SSH DEFAULTS
# ═══════════════════════════════════════════════════════════════════════════

Host *
    # Identity management
    AddKeysToAgent yes
    IgnoreUnknown AddKeysToAgent

    # Connection parameters
    ConnectTimeout 10
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Security
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ~/.ssh/known_hosts

    # Performance
    Compression yes
    ControlMaster auto
    ControlPath ~/.ssh/control-%h-%p-%r
    ControlPersist 600

    # Session
    LogLevel VERBOSE

# ═══════════════════════════════════════════════════════════════════════════
# USAGE EXAMPLES
# ═══════════════════════════════════════════════════════════════════════════

# SSH into production server
# $ ssh hetzner-prod
# $ ssh hetzner-prod-user

# SSH into new server
# $ ssh hetzner-new
# $ ssh hetzner-new-user

# Copy files to server
# $ scp -r ./project hetzner-prod:/root/clisonix-cloud

# Run remote command
# $ ssh hetzner-prod "docker ps"
# $ ssh hetzner-prod "docker logs clisonix-api"

# SSH tunnel for database access
# $ ssh -L 5432:localhost:5432 hetzner-prod

# SFTP file transfer
# $ sftp hetzner-prod
# sftp> cd /root/clisonix-cloud
# sftp> get config.json
# sftp> put config.json

# ═══════════════════════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════════════════

# 1. Replace placeholders:
#    - HETZNER_NEW_IP → your actual server IP
#    - HETZNER_DEV_IP → your actual dev server IP
#    - HETZNER_STAGING_IP → your actual staging server IP

# 2. Ensure SSH key permissions:
#    chmod 700 ~/.ssh
#    chmod 600 ~/.ssh/hetzner_deploy_key
#    chmod 644 ~/.ssh/hetzner_deploy_key.pub

# 3. Test connection:
#    ssh hetzner-prod
#    ssh hetzner-new

# 4. Add to SSH agent (optional but recommended):
#    ssh-add ~/.ssh/hetzner_deploy_key
