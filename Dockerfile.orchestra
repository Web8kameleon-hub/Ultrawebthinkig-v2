# ── Orchestra Division — container image ────────────────────────────────────
FROM python:3.12-slim

LABEL maintainer="Clisonix Engineering" \
      service="orchestra-division"      \
      port="9700"

# OS deps (git is needed by git_profile + gitignore probes)
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (layer cache)
COPY orchestra/requirements.txt /tmp/orchestra-requirements.txt
RUN pip install --no-cache-dir -r /tmp/orchestra-requirements.txt

# Copy only the orchestra package
COPY orchestra/ ./orchestra/

# Non-root user
RUN useradd -m -u 1001 orchestra && chown -R orchestra:orchestra /app
USER orchestra

EXPOSE 9700

HEALTHCHECK --interval=30s --timeout=8s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:9700/health || exit 1

CMD ["uvicorn", "orchestra.server:app", "--host", "0.0.0.0", "--port", "9700", "--workers", "1"]
