# Clisonix Workers for Platforms - Example configuration
# Copy this file to wrangler.toml and fill real IDs/names.
# Do NOT commit secrets. Set them using: wrangler secret put <NAME>

name = "clisonixwesterneurope"
main = "src/index.ts"
compatibility_date = "2026-04-17"
workers_dev = true

# Workers for Platforms dispatcher namespace used to launch customer workers.
dispatch_namespaces = [
  { binding = "DISPATCH_NAMESPACE", namespace = "vibesdk-default-namespace" }
]

# Cloudflare data bindings
[[kv_namespaces]]
binding = "BINDING_NAME"
id = "<KV_NAMESPACE_ID>"

[[d1_databases]]
binding = "DB"
database_name = "dbclisonix"
database_id = "<D1_DATABASE_ID>"

[[r2_buckets]]
binding = "TEMPLATES_BUCKET"
bucket_name = "vibesdk-templates"

[[r2_buckets]]
binding = "ASSETS_BUCKET"
bucket_name = "clisonixbucket"

[vars]
TEMPLATES_REPOSITORY = "https://github.com/cloudflare/vibesdk-templates"
ALLOWED_EMAIL = "clisonix@pm.me"
ENABLE_READ_REPLICAS = "true"
CLOUDFLARE_AI_GATEWAY = "vibesdk-gateway"
CUSTOM_DOMAIN = "www.clisonix.com"
MAX_SANDBOX_INSTANCES = "10"
SANDBOX_INSTANCE_TYPE = "standard-3"

# Build/deploy commands for CI wrappers
BUILD_COMMAND = "bun run build"
DEPLOY_COMMAND = "bun run deploy"

# Secrets (set via wrangler secret put)
# GOOGLE_AI_STUDIO_API_KEY
# JWT_SECRET
# WEBHOOK_SECRET
