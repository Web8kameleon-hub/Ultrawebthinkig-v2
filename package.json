{
  "name": "euroweb-platform",
  "version": "8.0.0",
  "description": "EuroWeb - Pure TypeScript Industrial Web8 Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dupes": "node --loader ts-node/esm tools/find-duplicates.ts --root ./ --out reports/dupes --threshold=0.90",
    "dupes:ci": "npm run dupes && node --loader ts-node/esm tools/fail-on-duplicates.ts --dup=reports/dupes/duplicates.json --near=reports/dupes/near-duplicates.json --maxExact=0 --maxNear=0",
    "dev": "next dev -H 127.0.0.1",
    "dev:web": "next dev -H 127.0.0.1 -p 3000",
    "dev:backend": "tsx backend/server.ts",
    "dev:api": "tsx backend/server.ts",
    "dev:full": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "ultra": "node scripts/dev-microservices.mjs",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "ultra:legacy": "yarn dev:full",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:system": "tsx test-system-comprehensive.mts",
    "test:mesh": "cd tests/mesh && python test_offline_store_forward.py",
    "test:all": "npm run test && npm run test:system && npm run test:mesh",
    "type-check": "tsc --noEmit",
    "lint": "next lint",
    "lint:check": "eslint . --ext .ts,.tsx --config eslint.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:lint": "npm run format && npm run lint",
    "pre-commit": "lint-staged",
    "tech:guard": "tsx scripts/tech-guard.ts",
    "verify:real-only": "node scripts/verify-real-only.mjs",
    "clean": "rimraf dist .next coverage",
    "clean:all": "npm run clean && rimraf node_modules && npm install",
    "sw:build": "tsx scripts/build-sw.ts build",
    "sw:watch": "tsx scripts/build-sw.ts watch",
    "sw:dev": "tsx scripts/build-sw.ts dev"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@huggingface/inference": "^4.7.1",
    "@opentelemetry/api": "^1.9.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.85.5",
    "@types/pako": "2.0.4",
    "@types/recharts": "^1.8.29",
    "@vanilla-extract/css": "^1.17.4",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "bufferutil": "^4.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "colors": "^1.4.0",
    "commander": "^13.1.0",
    "compromise": "^14.14.4",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eventemitter3": "5.0.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "fast-glob": "^3.3.3",
    "framer-motion": "^11.18.2",
    "franc-min": "^6.2.0",
    "helmet": "^8.1.0",
    "hot-formula-parser": "^4.0.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.7.0",
    "jspdf": "^3.0.2",
    "lucide-react": "^0.525.0",
    "mathjs": "^14.6.0",
    "next": "^14.2.0",
    "next-intl": "^4.3.5",
    "node-html-parser": "^6.1.13",
    "pako": "2.1.0",
    "pathe": "^2.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "pino": "^9.9.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.6.0",
    "react-to-print": "^3.1.1",
    "recharts": "^3.1.2",
    "rxjs": "7.8.2",
    "socket.io": "^4.8.1",
    "string_decoder": "^1.3.0",
    "supports-color": "^10.2.2",
    "systeminformation": "^5.27.8",
