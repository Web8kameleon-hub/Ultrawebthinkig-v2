    "@testing-library/jest-dom": "6.7.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/cors": "^2.8.19",
    "@types/eventemitter3": "2.0.4",
    "@types/express": "^5.0.3",
    "@types/helmet": "^4.0.0",
    "@types/hot-formula-parser": "^4.0.4",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/ui": "^3.2.4",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=18.0.0"
  },
  "author": {
