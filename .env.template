# Clisonix Cloud - Environment Configuration Template
# Copy to .env and fill with your values
# SECURITY: Never commit .env file!

# ==============================================================================
# 🔐 DATABASE ENCRYPTION (GDPR Compliance)
# ==============================================================================
DATABASE_ENCRYPTION_KEY=your-fernet-encryption-key-here
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clisonix
DB_SSL_MODE=require

# ==============================================================================
# 💳 PAYMENT GATEWAYS (PSD2/SCA Compliance)
# ==============================================================================

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SEPA Direct Debit (EU)
SEPA_BIC=DEUTDEDDXXX

# PayPal Configuration
PAYPAL_CLIENT_ID=your_client_id_here
PAYPAL_CLIENT_SECRET=your_client_secret_here
PAYPAL_MODE=sandbox  # sandbox or live

# ==============================================================================
# 📊 MONITORING SYSTEM (Security & Compliance)
# ==============================================================================
ENABLE_MONITORING=true
MONITORING_INTERVAL=60
ALERT_THRESHOLD_CPU=80
ALERT_THRESHOLD_MEMORY=85
ALERT_THRESHOLD_DISK=90

# Grafana Configuration
GRAFANA_URL=http://localhost:3001
GRAFANA_API_KEY=your_grafana_api_key

# Prometheus Configuration
PROMETHEUS_URL=http://localhost:9090

# Alerting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_EMAIL=alerts@clisonix.cloud

# ==============================================================================
# 🤖 AI MODEL VERSIONING (EU AI Act Compliance)
# ==============================================================================
MODEL_REGISTRY_PATH=./model_registry.json
MODEL_STORAGE_PATH=./models/
OLLAMA_API_URL=http://localhost:11434

# ==============================================================================
# 🔑 API KEYS & AUTHENTICATION
# ==============================================================================
API_SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Social authentication (Google / Auth.js)
AUTH_SECRET=your-auth-secret-here
AUTH_GOOGLE_ID=your_google_oauth_client_id_here
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret_here
AUTH_GOOGLE_HD=

# ==============================================================================
# 🌐 SERVER CONFIGURATION
# ==============================================================================
ENVIRONMENT=production  # development, staging, production
DEBUG=false
LOG_LEVEL=INFO
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_PORT=5000
WEB_PORT=3000

# ==============================================================================
# 📱 FRONTEND CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_API_URL=https://api.clisonix.cloud
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=https://clisonix.cloud

# ==============================================================================
# 🗄️ REDIS CACHE (Optional)
# ==============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password
CACHE_TTL=3600

# ==============================================================================
# 📧 EMAIL CONFIGURATION
# ==============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@clisonix.cloud

# ==============================================================================
# 🔐 SECURITY HEADERS
# ==============================================================================
CORS_ORIGINS=https://clisonix.cloud,https://www.clisonix.cloud
CSRF_TRUSTED_ORIGINS=https://clisonix.cloud
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=true

# ==============================================================================
# 📋 COMPLIANCE & AUDIT
# ==============================================================================
GDPR_ENABLED=true
PSD2_ENABLED=true
PCI_DSS_ENABLED=true
AI_ACT_COMPLIANCE=true
AUDIT_LOGGING=true
DATA_RETENTION_DAYS=2555  # 7 years for financial records

# ==============================================================================
# 🪙 ALB / UTT CANONICAL SOLANA CONFIG
# ==============================================================================
# Canonical ALB mint (set to official value for active runtime)
SOLANA_ALB_MINT=HSEcf132J4dNz46gw5fsVV7xfgedeFyTZXMSHcroz3BU
# Canonical ALB authority wallet
SOLANA_ALB_AUTHORITY=AuGX5kaG3ydcJLaGTUptSKnbC4y3MeUp1qds8mYJt9ua
# UTT authority used by API surfaces
UTT_AUTHORITY=AuGX5kaG3ydcJLaGTUptSKnbC4y3MeUp1qds8mYJt9ua
NEXT_PUBLIC_UTT_AUTHORITY=AuGX5kaG3ydcJLaGTUptSKnbC4y3MeUp1qds8mYJt9ua
# Solana network and RPC endpoint
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=
# Bridge signer (choose one of the two options below)
SOLANA_BRIDGE_KEYPAIR_B58=
SOLANA_BRIDGE_KEYPAIR_PATH=

# ==============================================================================
# 🧪 GOVERNANCE + LABOR RUNTIME (1-2-3 HIERARCHY)
# ==============================================================================
GOVERNANCE_QUANTUM_ENABLED=false
GOVERNANCE_DDOS_ENABLED=true
GOVERNANCE_MESH_HQ_ENABLED=true
ONNX_RUNTIME_ENABLED=false

# Comma-separated model lists
LABOR_VISION_MODELS=yolo,resnet50,easyocr
LABOR_NLP_MODELS=bert,bart,sentiment,java-longo
LABOR_AUDIO_MODELS=whisper
LABOR_SYNTHESIS_MODELS=gpt-2

# Java Longo integration
JAVA_LONGO_ENABLED=false
JAVA_LONGO_URL=http://localhost:8099

# Balancer log controls (set conservative defaults to avoid disk growth)
BALANCER_NODES_LOG_LEVEL=warning
BALANCER_NODES_ACCESS_LOG=false
BALANCER_NODES_EVENT_LOG=false
