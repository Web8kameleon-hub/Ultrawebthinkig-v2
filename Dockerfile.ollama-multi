# Dockerfile.ollama-multi - Ollama Multi-Model API Service
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/base.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir uvicorn fastapi pydantic

COPY ocean-core/ollama_multi_api.py ./
COPY ocean-core/ollama_multi_engine.py ./

EXPOSE 4444

CMD ["python", "-m", "uvicorn", "ollama_multi_api:app", "--host", "0.0.0.0", "--port", "4444"]
