# ========================================================
# Clisonix Cloud - Environment Variables Template
# ========================================================
# Copy this file to .env and set secure values
# DO NOT commit .env with real passwords to git
#
# Generation commands:
#   Strong password (32 chars): openssl rand -base64 32
#   JWT secret (64 chars): openssl rand -base64 64
# ========================================================

# ========================================================
# DATABASE CREDENTIALS (PostgreSQL)
# ========================================================
# Generate: openssl rand -base64 32
POSTGRES_USER=clisonix
POSTGRES_PASSWORD=GENERATE_SECURE_PASSWORD_32_CHARS_MIN
POSTGRES_DB=clisonixdb

# ========================================================
# GRAPH DATABASE (Neo4j)
# ========================================================
# Format: neo4j/<password>
# Generate password: openssl rand -base64 32
NEO4J_PASSWORD=GENERATE_SECURE_PASSWORD_32_CHARS_MIN

# ========================================================
# OBJECT STORAGE (MinIO)
# ========================================================
# Access key: username for S3-compatible API
# Secret password: openssl rand -base64 32
MINIO_ROOT_USER=clisonix
MINIO_ROOT_PASSWORD=GENERATE_SECURE_PASSWORD_32_CHARS_MIN

# ========================================================
# AUTHENTICATION & SECURITY
# ========================================================
# JWT Secret for API token signing
# Generate: openssl rand -base64 64
JWT_SECRET=GENERATE_SECURE_JWT_SECRET_64_CHARS_MIN

# API Secret key for session management
# Generate: openssl rand -hex 32
API_SECRET_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32

# ========================================================
# PAYMENT INTEGRATIONS (Optional)
# ========================================================
# Stripe API Keys
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_YOUR_TEST_KEY_OR_LIVE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_KEY_OR_LIVE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_TEST_SECRET

# PayPal API (Optional)
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=GENERATE_PAYPAL_SECRET

# SEPA Configuration (Optional)
SEPA_MERCHANT_ID=YOUR_SEPA_MERCHANT_ID
SEPA_API_KEY=GENERATE_SEPA_API_KEY

# ========================================================
# EMAIL/SMTP CONFIGURATION
# ========================================================
# SMTP Server for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=GENERATE_SECURE_APP_PASSWORD

# From address for transactional emails
MAIL_FROM=noreply@clisonix.com
MAIL_FROM_NAME=Clisonix Cloud

# ========================================================
# DEBUG & LOGGING
# ========================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Debug mode (set to false in production)
DEBUG=false

# Environment name
ENVIRONMENT=production

# ========================================================
# MONITORING & OBSERVABILITY
# ========================================================
# Grafana Admin dashboard password
# Generate: openssl rand -base64 16
GRAFANA_ADMIN_PASSWORD=GENERATE_SECURE_PASSWORD_16_CHARS_MIN

# Prometheus scrape interval (seconds)
PROMETHEUS_SCRAPE_INTERVAL=15

# ========================================================
# LLM & AI SERVICES
# ========================================================
# Ollama configuration
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI API (Optional fallback)
OPENAI_API_KEY=sk_test_YOUR_OPENAI_KEY

# HuggingFace Models (Optional)
HUGGINGFACE_API_KEY=hf_YOUR_HUGGINGFACE_TOKEN

# ========================================================
# CACHE & SESSION
# ========================================================
# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Session cache TTL (seconds)
SESSION_TTL=3600

# ========================================================
# DEPLOYMENT & INFRASTRUCTURE
# ========================================================
# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# External domain
DOMAIN=clisonix.com
PROTOCOL=https

# Hetzner Cloud (Deployment)
HETZNER_API_TOKEN=GENERATE_HETZNER_API_TOKEN

# ========================================================
# SERVICE PORTS (Docker-based)
# ========================================================
# Main API
API_PORT=8000

# EEG & Bio Services
ALBI_EEG_PORT=6680
ALBI_USER_PORT=6681

# JONA Neural Synthesis
JONA_PORT=7777

# Data & Cache
POSTGRES_PORT=5432
REDIS_PORT=6379
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# Object Storage
MINIO_PORT_API=9000
MINIO_PORT_CONSOLE=9001

# LLMs
OLLAMA_PORT=11434

# ========================================================
# SECURITY POLICIES
# ========================================================
# Rate limiting configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# CORS settings
CORS_ORIGINS=https://clisonix.com,https://www.clisonix.com
CORS_CREDENTIALS=true

# Session security
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# ========================================================
# BACKUP & STORAGE
# ========================================================
# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# ========================================================
# NOTES
# ========================================================
# 1. NEVER commit .env file with real values
# 2. Use .env.example for template only
# 3. Generate all CHANGE_ME values before deployment
# 4. Rotate all secrets every 90 days
# 5. Store secrets in secure vaults:
#    - Production: Use cloud provider's secret storage
#    - Development: Use local .env (gitignored)
#    - CI/CD: Use GitHub/GitLab secret management
#
# Secure Password Generation:
#   - 32 chars: openssl rand -base64 32
#   - 64 chars: openssl rand -base64 64
#   - Hex 32:  openssl rand -hex 32
#
# ========================================================
