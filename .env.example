# Real Free API Keys for ASI Independence
# Get these keys (all free tiers)

# OpenWeatherMap (1000 calls/day free)
OPENWEATHER_KEY=your_openweathermap_free_key_here
# Sign up: https://openweathermap.org/api

# NewsAPI (100 requests/day free)
NEWSAPI_KEY=your_newsapi_free_key_here
# Sign up: https://newsapi.org

# CoinGecko (no key needed, rate limited)
COINGECKO_API=https://api.coingecko.com/api/v3

# GitHub Personal Access Token (optional)
GITHUB_TOKEN=ghp_your_free_github_token

# Internal DB
DATABASE_URL=./asi_data.db

# Local Express backend used by /api/bridge/* and /api/platform/status
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
BACKEND_INTERNAL_URL=http://127.0.0.1:3001
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000
NEXT_PUBLIC_BACKEND_BRIDGE_URL=/api/bridge

