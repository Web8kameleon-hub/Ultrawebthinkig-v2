FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements/monetization-services.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy service
COPY services/developer_portal.py .

# Expose port
EXPOSE 8005

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD curl -f http://localhost:8005/health || exit 1

# Run
CMD ["python", "developer_portal.py"]
