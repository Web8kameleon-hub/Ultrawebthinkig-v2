FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN pip install --no-cache-dir uvicorn fastapi pydantic aiohttp

COPY shopping_therapy_core.py .
COPY shopping_therapy_service.py .
RUN mkdir -p /app/data

EXPOSE 7300
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD curl -f http://localhost:7300/health || exit 1
CMD ["python", "-m", "uvicorn", "shopping_therapy_service:app", "--host", "0.0.0.0", "--port", "7300"]
