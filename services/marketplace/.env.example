# ============================================================================
# CLISONIX MARKETPLACE SERVICE - ENVIRONMENT TEMPLATE
# ============================================================================
# Kopjo këtë file si .env dhe plotëso vlerat
# ============================================================================

# Server
PORT=8004
HOST=0.0.0.0
DEBUG=false

# Service Info
SERVICE_NAME=clisonix-marketplace
SERVICE_VERSION=1.0.0

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://app.clisonix.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/clisonix_marketplace

# Redis
REDIS_URL=redis://localhost:6379/1

# API Key Settings
API_KEY_PREFIX=clx_
API_KEY_LENGTH=32
API_KEY_SALT=your-salt-here

# Rate Limiting
DEFAULT_RATE_LIMIT_PER_MINUTE=10
DEFAULT_DAILY_LIMIT=50

# Stripe (for billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# JWT
JWT_SECRET_KEY=your-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Monitoring
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=clisonix-marketplace
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Feature Flags
ENABLE_STRIPE_BILLING=true
ENABLE_USAGE_TRACKING=true
ENABLE_RATE_LIMITING=true
ENABLE_ANALYTICS=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
