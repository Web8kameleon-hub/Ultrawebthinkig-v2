# Clisonix Newsroom Service Configuration (example)
# Copy to .env locally or map these values via GitHub Secrets / deployment secrets.

# === NEWS PUBLISHING ===
BLOG_API_URL=http://blog-api:8041/api/publish
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_TOKEN=your_facebook_page_token

# === NEWSROOM ===
NEWSROOM_PORT=9800
PUBLISH_INTERVAL=1800
MAX_LABS=200
POSTS_PER_DAY=10
AUTO_PUBLISH_AFTER_ETHICS=true

# === ETHICS ===
MIN_SOURCES_REQUIRED=2
ALLOW_SPECULATION=false
ALLOW_EMOTIONAL_LANGUAGE=false
ALLOW_UNVERIFIED_CLAIMS=false

# === REDIS ===
REDIS_URL=redis://redis:6379/1
