# MALI runtime tuning profile (safe defaults for production)
# Copy values into your runtime env/secrets system.

# Intake HTTP resilience
MALI_CONNECT_TIMEOUT=2.5
MALI_READ_TIMEOUT=5.0
MALI_RETRY_ATTEMPTS=2
MALI_RETRY_BACKOFF_MS=250

# Dynamic monitoring interval
MALI_CYCLE_INTERVAL=60
MALI_CYCLE_INTERVAL_MIN=15
MALI_CYCLE_INTERVAL_MAX=180
MALI_CYCLE_INTERVAL_STEP=5

# Cycle archive (local, gitignored)
MALI_CYCLE_ARCHIVE_ENABLED=true
MALI_CYCLE_ARCHIVE_DIR=runtime/mali-cycles
MALI_CYCLE_ARCHIVE_ROTATE_MB=8
MALI_CYCLE_ARCHIVE_MAX_TOTAL_MB=64
MALI_CYCLE_ARCHIVE_RETENTION_DAYS=3
MALI_CYCLE_ARCHIVE_MAX_FILES=80
MALI_CYCLE_ARCHIVE_MAINTENANCE_EVERY=20

# In-memory history caps
MALI_MAX_PATTERNS=2000
MALI_MAX_CORRELATIONS=1000
MALI_MAX_PREDICTIONS=500
