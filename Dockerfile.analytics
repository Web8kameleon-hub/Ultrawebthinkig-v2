FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies directly
RUN pip install --no-cache-dir uvicorn fastapi pandas numpy scikit-learn pydantic

COPY advanced_analytics_api.py .
COPY ai_model_versioning.py .

EXPOSE 8007

CMD sh -c "python -m uvicorn advanced_analytics_api:app --host 0.0.0.0 --port ${PORT:-8007}"
